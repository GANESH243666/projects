# Copy this file to local.properties and set your provider key.
# This file is never packaged into the APK.
llm_api_key=replace-with-your-key
llm_api_url=https://api.openai.com/v1/chat/completions
llm_model=gpt-4o-mini
cloud_tts_api_key=
cloud_tts_api_url=https://api.openai.com/v1/audio/speech
cloud_tts_model=gpt-4o-mini-tts
cloud_tts_voice=alloy
